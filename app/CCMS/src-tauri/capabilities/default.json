{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window — full network access for API proxy",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-set-size",
    "core:window:allow-set-title",
    "core:webview:default"
  ]
}
